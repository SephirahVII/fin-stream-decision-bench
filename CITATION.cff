message: "If you use this benchmark, please cite it as below."
title: "fin-stream-decision-bench: evaluating timely, auditable agent decisions over continuously updating financial data streams"
version: 1.4.0
date-released: 2026-11-12
authors:
  - family-names: "Wang"
    given-names: "Wayne"
    alias: "SephirahVII"
repository-code: "https://github.com/SephirahVII/fin-stream-decision-bench"
